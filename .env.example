# Copy to .env and adjust. Never commit .env.

# LLM: small local model served by Ollama through its OpenAI-compatible endpoint.
# Inside Docker use http://host.docker.internal:11434/v1 (Ollama runs on the host).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# SQLite files for the two backends (created and seeded on first start)
FLEET_DB_PATH=data/fleet.db
ERP_DB_PATH=data/erp.db

# Where the simulator posts telemetry
FLEET_API_URL=http://localhost:8001
